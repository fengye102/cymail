{
  "manifest_version": 3,
  "name": "CYMail 网页邮箱授权",
  "version": "1.3.0",
  "description": "将用户主动授权的 iCloud 或 163 网页邮箱会话安全提交给 CYMail。",
  "permissions": ["cookies", "tabs", "storage"],
  "host_permissions": [
    "https://*.icloud.com/*",
    "https://*.icloud.com.cn/*",
    "https://idmsa.apple.com/*",
    "https://account.apple.com/*",
    "https://appleid.apple.com/*",
    "https://*.163.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "CYMail iCloud 授权",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["admin-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.icloud.com/*",
        "https://*.icloud.com.cn/*"
      ],
      "js": ["icloud-authorize.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.163.com/*",
        "https://*.mail.163.com/*"
      ],
      "js": ["netease-authorize.js"],
      "run_at": "document_idle"
    }
  ]
}
